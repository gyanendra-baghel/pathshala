generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model School {
  id             Int             @id @default(autoincrement())
  name           String
  email          String          @unique
  phone          String
  schoolBoard    SchoolBoard     // Example: "CBSE", "ICSE"
  address        String
  postalCode     String
  config         Json            // Custom settings for the school (optional)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  admins         Admin[]
  teachers       Teacher[]
  students       Student[]
  feeStructures  FeeStructure[]
  grades         Grade[]
  announcements  Annoncements[]
  reports        Reports[]
}
 
model Admin {
  id             Int              @id @default(autoincrement())
  schoolId       Int
  name           String
  email          String           @unique
  password       String
  role           AdminRole        @default(MAIN_ADMIN)
  phoneNumber    String
  updatedAt      DateTime         @updatedAt
  createdAt      DateTime         @default(now())

  school         School           @relation(fields: [schoolId], references: [id])
}

model Teacher {
  id            Int               @id @default(autoincrement())
  name          String
  email         String            @unique
  password      String
  address       String
  schoolId      Int
  joinDate      DateTime          @default(now())
  photo         String?

  school        School           @relation(fields: [schoolId], references: [id])
  grades        Grade[]
  subjects      SubjectTeacher[]
}

model Student {
  id            Int              @id @default(autoincrement())
  firstName     String
  lastName      String
  dob           String
  email         String           @unique
  password      String
  phoneNumber   String
  aadharNumber  String
  fatherName    String
  motherName    String
  address       String
  photo         String?
  gradeId       Int
  schoolId      Int
  enrollmentDate DateTime      @default(now())

  school        School         @relation(fields: [schoolId], references: [id])
  grade         Grade          @relation(fields: [gradeId], references: [id])
  fees          Fee[]
  attendance    Attendance[]
  subjects      SubjectStudent[]
  fee_structures FeeStructure?
  reports       Reports[]
}

// Grade(Class) management

model Grade {
  id           Int            @id @default(autoincrement())
  name         String         // Example: "Grade 1", "Grade 10"
  classTeacherId Int?         // Optional: Class teacher for this grade
  schoolId     Int
  schedule     Json          // Store structured schedule data

  students     Student[]
  subjects     Subject[]      // Subjects in this grade
  subjectStudents SubjectStudent[]
  teachers     SubjectTeacher[]

  school        School         @relation(fields: [schoolId], references: [id])
  classTeacher  Teacher?       @relation(fields: [classTeacherId], references: [id])
}

model Subject {
  id          Int       @id @default(autoincrement())
  gradeId     Int?
  name        String    @unique
  description String?
  schoolId    Int

  teachers    SubjectTeacher[]
  students    SubjectStudent[]
  attendance  Attendance[]
  grade       Grade?     @relation(fields: [gradeId], references: [id])
}

// Subject-Teacher mapping
model SubjectTeacher {
  id        Int       @id @default(autoincrement())
  subjectId Int
  gradeId   Int
  teacherId Int      // Assigned teacher for this subject and grade

  subject   Subject   @relation(fields: [subjectId], references: [id])
  grade     Grade     @relation(fields: [gradeId], references: [id])
  teacher   Teacher  @relation(fields: [teacherId], references: [id])
}

// Subject-Student mapping
model SubjectStudent {
  id        Int       @id @default(autoincrement())
  subjectId Int
  gradeId   Int
  studentId Int      // Assigned student for this subject and grade

  subject   Subject   @relation(fields: [subjectId], references: [id])
  grade     Grade     @relation(fields: [gradeId], references: [id])
  student   Student  @relation(fields: [studentId], references: [id])
}

// Attendance Management

model Attendance {
  id            Int            @id @default(autoincrement())
  subjectId     Int
  studentId     Int
  date          DateTime       @default(now())
  status        AttendanceStatus
  reason        String?        // Optional reason for absence or lateness

  subject       Subject          @relation(fields: [subjectId], references: [id])
  student       Student        @relation(fields: [studentId], references: [id])
}

// Fee Management

model Fee {
  id            Int            @id @default(autoincrement())
  studentId     Int     
  feeStructureId Int
  status        FeeStatus
  amount        Float
  description   String?
  schoolId      Int
  createdAt      DateTime         @default(now())

  student       Student        @relation(fields: [studentId], references: [id])
  feeStructure  FeeStructure   @relation(fields: [feeStructureId], references: [id])
}

model FeeStructure {
  id            Int            @id @default(autoincrement())
  studentId     Int            @unique
  schoolId      Int
  frequency     FeeFrequency
  tuitionFee    Decimal         @default(0.00)
  transportFee  Decimal         @default(0.00)
  mealFee       Decimal         @default(0.00)
  libraryFee    Decimal         @default(0.00)
  otherFee      Decimal         @default(0.00)
  description   String? 
  startDate     DateTime        @default(now())
  endDate       DateTime        @default(now())
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  school        School         @relation(fields: [schoolId], references: [id])
  student       Student        @relation(fields: [studentId], references: [id])
  fees          Fee[]
}

enum FeeType {
  TUITION
  TRANSPORT
  EXTRACURRICULAR
  OTHER
}

enum FeeFrequency {
  MONTHLY
  YEARLY
  ONCE
}

enum FeeStatus {
  PARTIAL_PAID
  PENDING
  PAID
  OVERDUE
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum AdminRole {
  MAIN_ADMIN
  FINANCE_ADMIN
  ACADEMIC_MANAGER
}

enum SchoolBoard {
  CBSE
  ICSE
  STATE_BOARD
  OTHER
}

model Annoncements {
  id            Int            @id @default(autoincrement())
  schoolId      Int
  title         String
  description   String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  school        School         @relation(fields: [schoolId], references: [id])
}

model Reports {
  id            Int            @id @default(autoincrement())
  schoolId      Int
  title         String
  description   String
  studentId     Int
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  school        School         @relation(fields: [schoolId], references: [id])
  student       Student        @relation(fields: [studentId], references: [id])
}
