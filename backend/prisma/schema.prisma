generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model School {
  id             Int             @id @default(autoincrement())
  name           String
  email          String          @unique
  phone          String
  schoolBoard    SchoolBoard     // Example: "CBSE", "ICSE"
  address        String
  postalCode     String
  config         Json            // Custom settings for the school (optional)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  admins         Admin[]
  teachers       Teacher[]
  students       Student[]
  feeStructures  FeeStructure[]
  grades         Grade[]
}
 
model Admin {
  id             Int              @id @default(autoincrement())
  schoolId       Int
  name           String
  email          String           @unique
  password       String
  role           AdminRole        @default(MAIN_ADMIN)
  phoneNumber    String
  updatedAt      DateTime         @updatedAt
  createdAt      DateTime         @default(now())

  school         School           @relation(fields: [schoolId], references: [id])
}

model Teacher {
  id            Int               @id @default(autoincrement())
  name          String
  email         String            @unique
  password      String
  address       String
  schoolId      Int
  joinDate      DateTime          @default(now())

  school        School           @relation(fields: [schoolId], references: [id])
  grades        Grade[]
  subjects      SubjectGrade[]
}

model Student {
  id            Int              @id @default(autoincrement())
  firstName     String
  lastName      String
  dob           String
  email         String           @unique
  password      String
  phoneNumber   String
  aadharNumber  String
  fatherName    String
  motherName    String
  address       String
  gradeId       Int
  schoolId      Int
  enrollmentDate DateTime      @default(now())

  school        School         @relation(fields: [schoolId], references: [id])
  grade         Grade          @relation(fields: [gradeId], references: [id])
  fees          Fee[]
  attendance    Attendance[]
}

// Grade(Class) management

model Grade {
  id           Int            @id @default(autoincrement())
  name         String         // Example: "Grade 1", "Grade 10"
  classTeacherId Int?         // Optional: Class teacher for this grade
  schoolId     Int
  schedule     Json          // Store structured schedule data

  students     Student[]
  subjects     SubjectGrade[] // Subjects in this grade

  school        School         @relation(fields: [schoolId], references: [id])
  classTeacher  Teacher?       @relation(fields: [classTeacherId], references: [id])
  attendance    Attendance[]
}

model Subject {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  description String?
  schoolId    Int

  subjectGrades SubjectGrade[]
}

model SubjectGrade {
  id        Int       @id @default(autoincrement())
  subjectId Int
  gradeId   Int
  teacherId Int      // Assigned teacher for this subject and grade

  subject   Subject   @relation(fields: [subjectId], references: [id])
  grade     Grade     @relation(fields: [gradeId], references: [id])
  teacher   Teacher  @relation(fields: [teacherId], references: [id])
}

// Attendance Management

model Attendance {
  id            Int            @id @default(autoincrement())
  gradeId       Int?
  studentId     Int
  date          DateTime       @default(now())
  status        AttendanceStatus
  reason        String?        // Optional reason for absence or lateness

  grade         Grade?          @relation(fields: [gradeId], references: [id])
  student       Student        @relation(fields: [studentId], references: [id])
}

// Fee Management

model Fee {
  id            Int            @id @default(autoincrement())
  studentId     Int
  feeStructureId Int
  status        FeeStatus
  amount        Float
  createdAt      DateTime         @default(now())

  student       Student        @relation(fields: [studentId], references: [id])
  feeStructure  FeeStructure   @relation(fields: [feeStructureId], references: [id])
}

model FeeStructure {
  id            Int            @id @default(autoincrement())
  schoolId      Int
  gradeId       Int?
  feeType       FeeType
  amount        Float
  frequency     FeeFrequency
  dueDate       DateTime

  school        School         @relation(fields: [schoolId], references: [id])
  fees          Fee[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
}

enum FeeType {
  TUITION
  TRANSPORT
  EXTRACURRICULAR
  OTHER
}

enum FeeFrequency {
  MONTHLY
  YEARLY
  ONCE
}

enum FeeStatus {
  PARTIAL_PAID
  PENDING
  PAID
  OVERDUE
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum AdminRole {
  MAIN_ADMIN
  FINANCE_ADMIN
  ACADEMIC_MANAGER
}

enum SchoolBoard {
  CBSE
  ICSE
  STATE_BOARD
  OTHER
}
